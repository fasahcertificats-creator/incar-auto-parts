# Base URL the browser uses to call the INCAR backend directly. Leave empty
# to use same-origin requests (proxied server-side via next.config.ts rewrites
# to INCAR_API_INTERNAL_URL below) — this is the default for local dev.
NEXT_PUBLIC_INCAR_API_BASE_URL=

# Server-side target for the /v1/:path* rewrite in next.config.ts. Not
# exposed to the browser. Defaults to http://localhost:4000 if unset.
INCAR_API_INTERNAL_URL=http://localhost:4000

# INCAR's confirmed WhatsApp number, digits and formatting as you want it
# displayed (e.g. "+966 5X XXX XXXX"). Leave empty to hide the WhatsApp CTA
# entirely rather than show a placeholder — do not set this to a fake number.
NEXT_PUBLIC_WHATSAPP_NUMBER=
